# 复制这个文件为 .env.local，填入真实值，不要 commit .env.local

# Anthropic Claude API（去 https://console.anthropic.com/ 获取）
ANTHROPIC_API_KEY=sk-ant-xxx

# Notion Integration Token（去 https://www.notion.so/profile/integrations 获取）
NOTION_TOKEN=secret_xxx

# Notion Database ID（数据库页面 URL 里的 32 位字符串）
NOTION_DATABASE_ID=xxx

# App 名称（前端可读）
NEXT_PUBLIC_APP_NAME=lovely-shelf
