# 复制这个文件为 .env.local，填入真实值，不要 commit .env.local

# Anthropic Claude API（去 https://console.anthropic.com/ 获取）
ANTHROPIC_API_KEY=sk-ant-xxx

# Notion Integration Token（去 https://www.notion.so/profile/integrations 获取）
NOTION_TOKEN=secret_xxx

# Notion Database ID（数据库页面 URL 里的 32 位字符串）
NOTION_DATABASE_ID=xxx

# App 名称（前端可读）
NEXT_PUBLIC_APP_NAME=lovely-shelf

# NextAuth 加密密钥（必填，运行 `npx auth secret` 生成）
AUTH_SECRET=xxx

# Google OAuth（去 https://console.cloud.google.com/ 创建 OAuth 客户端）
AUTH_GOOGLE_ID=xxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=xxx

# 允许登录的邮箱列表，逗号分隔（留空则不限制）
AUTH_ALLOWED_EMAILS=you@example.com,other@example.com

# Pexels 图片 API（去 https://www.pexels.com/api/ 获取）
PEXELS_API_KEY=xxx

# Pixabay 图片 API（去 https://pixabay.com/api/docs/ 获取）
PIXABAY_API_KEY=xxx

# Jamendo 音乐 API（去 https://developer.jamendo.com/ 获取）
JAMENDO_CLIENT_ID=xxx

# 是否启用 AI Agent 模式（前端可读，填 true/false）
NEXT_PUBLIC_USE_AGENT=false
